# Copy to .env and fill in. .env is gitignored and never leaves this machine.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY

# Gmail integration (optional). From a Google Cloud OAuth client of type
# "Desktop app" -- see the "Gmail setup" section in README.md. After setting
# these, run `uv run python scripts/gmail_auth.py` once to authorize.
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET

# Optional overrides
# JARVIS_PORT=8787
